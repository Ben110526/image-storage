{
  "name": "imgstore-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/generate-design-tokens.mjs && node scripts/generate-appearance-bootstrap.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check && node scripts/generate-appearance-bootstrap.mjs --check",
    "predev": "npm run tokens",
    "dev": "vite",
    "dev:qa": "vite --config vite.qa.config.ts",
    "dev:qa:api": "node scripts/qa-fixture-server.mjs",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "notistack": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.134.0"
  }
}
